{
  "name": "vita-cat-admin-fusion",
  "version": "2.11.5",
  "license": "MIT",
  "author": {
    "name": "hean",
    "email": "hi@bingtang.im",
    "url": "https://hean.im"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "bootstrap": "pnpm install",
    "build:clean": "pnpm store prune && rimraf dist electron/dist",
    "build:desktop": "pnpm build:web && pnpm build:nest && pnpm build:prepare:nest:prod  && pnpm build:electron",
    "build:electron": "pnpm build:electron:compile && pnpm build:electron:pack",
    "build:electron:compile": "tsc -p electron.tsconfig.json",
    "build:electron:pack": "electron-builder",
    "build:nest": "pnpm --filter ./apps/nest-server build",
    "build:no-cache": "pnpm store prune && npm run build",
    "build:prepare:nest:prod": "node scripts/prepare-nest-prod.mjs",
    "build:web": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build",
    "build:web:beta": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --mode beta",
    "build:web:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --mode development",
    "commit": "czg",
    "dev:desktop": "concurrently -k -r \"pnpm dev:electron\" \"node scripts/dev-electron.mjs\"",
    "dev:electron": "tsc -p electron.tsconfig.json --watch",
    "dev:web": "pnpm vite",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "turbo run stub",
    "lint": "turbo run lint",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write .",
    "lint:stylelint": "stylelint \"**/*.{vue,css,less,scss}\" --fix --cache --cache-location node_modules/.cache/stylelint/",
    "log": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "preview": "npm run build && vite preview",
    "reinstall": "rimraf pnpm-lock.yaml && rimraf apps/**/node_modules && rimraf package.lock.json && rimraf node_modules && npm run bootstrap",
    "serve": "npm run dev",
    "test:gzip": "npx http-server dist --cors --gzip -c-1",
    "type:check": "vue-tsc --noEmit --skipLibCheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
      "prettier --write--parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix",
      "stylelint --fix"
    ],
    "*.{scss,less,styl,html}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fabric-fusion/core": "^1.2.3",
    "@iconify/iconify": "^3.1.1",
    "@logicflow/core": "^1.2.26",
    "@logicflow/extension": "^1.2.26",
    "@pnext/three-loader": "^0.5.15",
    "@sentry/vite-plugin": "^3.2.2",
    "@sentry/vue": "^9.5.0",
    "@types/ali-oss": "^6.16.11",
    "@types/fabric": "^5.3.9",
    "@types/lodash": "^4.17.15",
    "@vben/hooks": "workspace:*",
    "@vue/shared": "^3.4.25",
    "@vueuse/core": "^10.9.0",
    "@zxcvbn-ts/core": "^3.0.4",
    "ali-oss": "^6.22.0",
    "ant-design-vue": "^4.2.1",
    "axios": "^1.6.8",
    "codemirror": "^5.65.16",
    "cropperjs": "^1.6.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "electron-is-dev": "^3.0.1",
    "exceljs": "^4.4.0",
    "fabric": "^5.5.1",
    "html2canvas": "^1.4.1",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "mockjs": "^1.1.0",
    "nanoid": "^5.0.9",
    "nprogress": "^0.2.0",
    "path-to-regexp": "^6.2.2",
    "pinia": "2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "print-js": "^1.6.0",
    "qrcode": "^1.5.3",
    "qs": "^6.12.1",
    "resize-observer-polyfill": "^1.5.1",
    "showdown": "^2.1.0",
    "sortablejs": "^1.15.2",
    "three": "^0.172.0",
    "tinymce": "^5.10.9",
    "unocss": "^0.59.4",
    "uuid": "^11.0.5",
    "vditor": "^3.10.4",
    "vue": "^3.4.25",
    "vue-i18n": "^9.13.1",
    "vue-json-pretty": "^2.4.0",
    "vue-router": "^4.3.2",
    "vue-types": "^5.1.1",
    "vuedraggable": "^4.1.0",
    "vxe-table": "4.4.5",
    "vxe-table-plugin-export-xlsx": "3.0.4",
    "xe-utils": "^3.5.25",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@iconify/json": "^2.2.203",
    "@purge-icons/generated": "^0.10.0",
    "@types/codemirror": "^5.60.15",
    "@types/crypto-js": "^4.2.2",
    "@types/estree": "^1.0.8",
    "@types/lodash-es": "^4.17.12",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^24.7.2",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.5",
    "@types/qs": "^6.9.15",
    "@types/showdown": "^2.0.6",
    "@types/sortablejs": "^1.15.8",
    "@types/three": "^0.173.0",
    "@vben/eslint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/ts-config": "workspace:*",
    "@vben/types": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vue/compiler-sfc": "^3.4.25",
    "@vue/test-utils": "^2.4.5",
    "concurrently": "^9.2.1",
    "conventional-changelog-cli": "^4.1.0",
    "cross-env": "^7.0.3",
    "cz-git": "^1.9.1",
    "czg": "^1.9.1",
    "electron": "^38.2.2",
    "electron-builder": "^26.4.0",
    "lint-staged": "15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-packagejson": "^2.5.0",
    "rimraf": "^5.0.5",
    "turbo": "^1.13.2",
    "typescript": "^5.4.5",
    "unbuild": "^2.0.0",
    "vite": "^5.2.10",
    "vite-plugin-mock": "^2.9.6",
    "vite-plugin-vue-devtools": "^7.2.0",
    "vue-tsc": "^2.0.14",
    "wait-on": "^9.0.1"
  },
  "packageManager": "pnpm@9.0.4",
  "engines": {
    "node": ">=18.12.0",
    "pnpm": ">=9.0.2"
  },
  "pnpm": {
    "overrides": {
      "canvas": "^3.2.1",
      "esbuild": "0.21.5",
      "node-gyp": "12.1.0"
    }
  },
  "build": {
    "appId": "com.yourcompany.yourapp",
    "productName": "YourApp",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": ".build/nest-server",
        "to": "nest-server",
        "filter": [
          "dist/**",
          "node_modules/**",
          "package.json"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}_Setup_${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
